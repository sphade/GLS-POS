{
  "name": "@gls-pos/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "GLS Kitchen & Bakery - public website (static HTML; SvelteKit for /pos and /film)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:svelte": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "clean": "node -e \"for (const d of ['build','.svelte-kit']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0"
  },
  "devDependencies": {
    "@gls-pos/typescript-config": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "^5.7.3",
    "vite": "8.3.2"
  }
}
