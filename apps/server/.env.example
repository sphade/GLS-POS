# Port the Hono server listens on
PORT=8787

# libsql/SQLite database.
# Local development: a file URL. Production: a Turso libsql URL + auth token.
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32+-char-random-secret
BETTER_AUTH_URL=http://localhost:8787

# Cloudflare deploy credential, used by wrangler for `deploy`, `secret` and D1.
# Create at: Cloudflare dashboard > My Profile > API Tokens > Create Token.
# Needs: Account > Workers Scripts: Edit, Account > D1: Edit,
#        Account > Account Settings: Read  (User > User Details: Read is optional)
#
# NOTE: whenever this is set — here OR as a shell environment variable — wrangler
# uses it and silently ignores `wrangler login`. If an OAuth login appears to
# have no effect, this is why. Unset it to fall back to OAuth.
CLOUDFLARE_API_TOKEN=
