# Port the Hono server listens on
PORT=8787

# libsql/SQLite database.
# Local development: a file URL. Production: a Turso libsql URL + auth token.
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32+-char-random-secret
BETTER_AUTH_URL=http://localhost:8787
