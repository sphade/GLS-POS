{
  "name": "gls-pos-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gls-pos-control",
      // Placeholder for local dev. Run `wrangler d1 create gls-pos-control`
      // and paste the returned id here before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "StoreDurableObject" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StoreDurableObject"]
    }
  ],
  // Allow importing Drizzle's generated .sql migrations as text modules
  // (used by the Store Durable Object's migrator).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "dev": { "port": 8787 }
}
