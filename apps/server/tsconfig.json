{
  "extends": "@gls-pos/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "allowJs": true,
    "declaration": false,
    "declarationMap": false
