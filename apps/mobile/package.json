{
  "name": "@gls-pos/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "clean": "rimraf .expo dist .turbo",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:prod": "eas build --platform android --profile production",
    "build:install": "eas build:run --platform android --latest",
    "submit:android": "eas submit --platform android --latest",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:all": "eas submit --platform all --latest",
    "build:android:prod:submit": "eas build --platform android --profile production --auto-submit",
    "build:ios:prod:submit": "eas build --platform ios --profile production --auto-submit",
    "ota": "eas update --branch production --environment production --message"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.5",
    "@gls-pos/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.5",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-application": "~55.0.17",
    "expo-audio": "~55.0.16",
    "expo-auth-session": "~55.0.17",
    "expo-build-properties": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-network": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-print": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-screen-orientation": "~55.0.18",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
