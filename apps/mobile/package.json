{
  "name": "@gls-pos/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "clean": "rimraf .expo dist .turbo",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:prod": "eas build --platform android --profile production",
    "build:install": "eas build:run --platform android --latest",
    "submit:android": "eas submit --platform android --latest",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:all": "eas submit --platform all --latest",
    "build:android:prod:submit": "eas build --platform android --profile production --auto-submit",
    "build:ios:prod:submit": "eas build --platform ios --profile production --auto-submit",
    "ota": "eas update --branch production --environment production --message"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@gls-pos/types": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@sentry/react-native": "~6.10.0",
    "@shopify/flash-list": "1.7.3",
    "@shopify/react-native-skia": "1.5.0",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.25",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-audio": "~0.3.5",
    "expo-auth-session": "~6.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-keep-awake": "~14.0.3",
    "expo-linking": "~7.0.3",
    "expo-localization": "~16.0.1",
    "expo-network": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-print": "~14.0.3",
    "expo-router": "~4.0.9",
    "expo-screen-orientation": "~8.0.4",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-qrcode-svg": "6.3.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
