# Base URL of the GLS-POS Worker API.
# Deployed backend (works from any device, no LAN setup needed):
EXPO_PUBLIC_API_URL=https://gls-pos-server.sphade012.workers.dev
# For local `wrangler dev` instead, use your computer's LAN IP on a physical
# device, e.g. http://192.168.1.20:8787 (localhost only works on web/simulator).

# Background sync master switch. Leave unset/0 to run the app fully offline
# (pure local SQLite demo, zero network calls). Set to 1 to sync with the server.
EXPO_PUBLIC_ENABLE_SYNC=0
