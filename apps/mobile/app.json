{
  "expo": {
    "name": "GLS-POS",
    "slug": "gls-pos",
    "version": "0.0.1",
    "orientation": "default",
    "scheme": "glspos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": { "policy": "appVersion" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gls.pos",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gls.pos",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-audio",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.1" },
          "android": { "minSdkVersion": 24 }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan barcodes and take product photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set product images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to take product photos."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to receipt printers and card readers over Bluetooth."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
